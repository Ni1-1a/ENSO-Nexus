# Шаблон .env для Windows-машины.
# Скопировать в корень проекта под именем .env и вписать ключи из .env с мака.
# Значения ниже повторяют боевую конфигурацию мака; отмечено то, что на Windows
# обязано отличаться. Пути пишутся с обратными слэшами, без кавычек.

# ── Ключи API ─────────────────────────────────────────────────────────────
# Переносятся с мака как есть. Пусто — провайдер просто не появится в выборе.
# Маршрут OpenAI мёртв с 10.08.2026 (аккаунт деактивирован) — ключ можно не переносить.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
KIMI_API_KEY=
GEMINI_API_KEY=

# ── Модели облачных провайдеров ───────────────────────────────────────────
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_MAX_TOKENS=128000
ANTHROPIC_REQUEST_TIMEOUT=1800000
ANTHROPIC_MAX_RETRIES=3
OPENAI_MODEL=gpt-5.6-terra
OPENAI_MAX_TOKENS=128000
OPENAI_REASONING_EFFORT=low
KIMI_MODEL=kimi-k2.6
KIMI_MAX_TOKENS=262144
GEMINI_MODEL=

# ── Локальные модели ──────────────────────────────────────────────────────
# Расклад: рабочая модель на маке, слабая LM Studio — на самой Windows.
# Подробности и обязательная правка model-manager.js — в 5-СХЕМЫ-РАЗМЕЩЕНИЯ.md.
AI_PROVIDER=local

# ГЛАВНЫЙ адрес — мак. Сюда жёстко ходят анализ, распознавание сканов
# и эмбеддинги базы знаний, поэтому vision-модель и модель эмбеддингов
# обязаны стоять именно там. Адрес мака закрепить в роутере (DHCP-резерв).
LOCAL_AI_BASE_URL=http://192.168.1.50:1234/v1
LOCAL_AI_MODEL=qwen/qwen3.5-35b-a3b
LOCAL_AI_OCR_MODEL=qwen/qwen3-vl-8b
LOCAL_AI_MAX_TOKENS=98304
LOCAL_AI_DOC_CHAR_LIMIT=90000
# Контексты обязаны совпадать с тем, что выставлено в LM Studio на маке,
# и подобраны так, чтобы чат-модель, vision и эмбеддинги помещались ОДНОВРЕМЕННО:
# выгружать соседа больше некому (менеджер моделей по сети не работает).
LOCAL_AI_CONTEXT=32768
LOCAL_AI_OCR_CONTEXT=16384
# Ни на что не влияет при удалённой LM Studio — оставлено для возврата к схеме
# «модели на этой же машине».
LOCAL_AI_EXCLUSIVE=1
LOCAL_AI_TIMEOUT=600000
VISION_MAX_PAGES=50

# Слабая LM Studio на самой Windows — вторым провайдером в пикере (запасной путь,
# когда мак выключен). В интерфейсе слот подписан «Ollama (локально)»; зрения
# и эмбеддингов у него по реестру нет, только текст.
OLLAMA_BASE_URL=http://localhost:1234/v1

# ── Сервер ────────────────────────────────────────────────────────────────
PORT=3000
DATA_DIR=
ARCHIVE_DIR=
# Слушать только петлю; наружу ходят через cloudflared.
# 0.0.0.0 включать только вместе с TRUST_PROXY=0 (см. 2-СЕТЬ-И-HAPP.md, п. 7).
BIND_HOST=127.0.0.1

# ── Мост AutoCAD ──────────────────────────────────────────────────────────
# ОБЯЗАТЕЛЬНО 0 на Windows: мост построен на AppleScript и работает только на macOS.
ACAD_ENABLED=0

# ── База знаний (RAG) ─────────────────────────────────────────────────────
# Сам индекс (12,5 тыс. чанков с эмбеддингами) лежит в data\app.db — поиск
# работает и без этой папки. Папка нужна только для переиндексации.
# Переменная при этом обязана быть НЕПУСТОЙ: из неё собирается список баз,
# иначе базы знаний в интерфейсе не будет вообще.
# Путь на сетевую папку писать UNC-именем (\\MAC\Knowledge-Base), не буквой
# подключённого диска: службе и задаче планировщика буквы не видны.
KB_DIR=D:\Базы\Knowledge-Base
KB_EMBEDDING_MODEL=text-embedding-qwen3-embedding-0.6b
KB_TOP_K=6
# База Гриши по умолчанию ищется соседней папкой рядом с KB_DIR, а её состав —
# в <KB_DIR>\07_Заметки\Коллекции\НТД_Гриша.md. При другой раскладке задать явно:
# KB_GRISHA_DIR=D:\Базы\Knowledge-Base-Гриша
# KB_GRISHA_COLLECTION=D:\Базы\Knowledge-Base\07_Заметки\Коллекции\НТД_Гриша.md

# ── Лимиты загрузки ───────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=25
MAX_TOTAL_UPLOAD_MB=60
MAX_FILES_PER_SESSION=10

# ── Лимиты диалога и расходов ─────────────────────────────────────────────
MAX_MESSAGE_LENGTH=4000
MAX_AI_REQUESTS_PER_SESSION=200
MAX_TOKENS_PER_SESSION=2000000
MAX_ANALYSIS_CALLS=12
MAX_CONTINUATIONS=4
MAX_CONCURRENT_JOBS=2

# ── Память диалога ────────────────────────────────────────────────────────
RECENT_MESSAGES_IN_CONTEXT=24
COMPACT_AFTER_MESSAGES=40

# ── Сессии и очистка ──────────────────────────────────────────────────────
# 0 — сессии не протухают (так на маке).
SESSION_TTL_HOURS=0
CLEANUP_INTERVAL_MINUTES=30

# ── Ограничение частоты (на IP) ───────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_GENERAL=120
RATE_LIMIT_EXPENSIVE=12

# ── Переменные, которых в коде ещё нет ────────────────────────────────────
# Появятся только вместе с патчами из 3-РАЗЛИЧИЯ-MAC-WINDOWS.md и
# 2-СЕТЬ-И-HAPP.md. Пока патчи не применены — строки ниже ни на что не влияют.
# LMS_PATH=C:\Users\<имя>\.lmstudio\bin\lms.exe
# POPPLER_DIR=C:\Tools\poppler\Library\bin
# DWG2DXF_PATH=C:\Tools\libredwg\bin\dwg2dxf.exe

# Выход через локальный прокси (Happ в режиме прокси). ПУСТО = напрямую.
# Платформа обязана работать при выключенном Happ — значит по умолчанию пусто.
# OUTBOUND_PROXY_URL=
