# Шаблон переменных окружения Enso-nexus. Скопировать в .env; секреты не коммитить.
# Умолчания — из server/config.js: незаданная переменная даёт ровно то значение,
# что записано здесь (где не сказано иное). Файл читает сам Node:
# `npm start` запускается с --env-file-if-exists=.env (Node ≥ 22.9).

# === Сервер ===
PORT=3000
# Какой интерфейс слушать. По умолчанию только петлевой: снаружи ходят через
# cloudflared. На 0.0.0.0 заголовок X-Forwarded-For подделывается из локальной
# сети, и ограничитель попыток входа обходится одной строкой. 0.0.0.0 нужен
# только в контейнере (Dockerfile и render.yaml выставляют его сами).
BIND_HOST=127.0.0.1
# Кому верить в X-Forwarded-For (`trust proxy` Express). loopback — только
# петлевому интерфейсу: сервер за cloudflared на той же машине, других хопов нет.
# Ещё: 0/false — никому (req.ip = адрес соединения); число — столько хопов;
# список адресов/подсетей через запятую.
TRUST_PROXY=loopback
# Каталог для БД, загрузок и результатов (на Render: /var/data при подключённом диске)
DATA_DIR=
# Постоянный архив результатов всех прогонов: копии складываются сюда при каждом
# завершённом анализе и переживают удаление сессий и TTL. Пусто — <DATA_DIR>/archive
ARCHIVE_DIR=
# Внешний адрес платформы. Пока читается в config.js и нигде не используется — задел.
PUBLIC_BASE_URL=

# === Вход и люди ===
# Список людей платформы: ФИО, режим регистрации (free/approval), флаги approved,
# cloudAi, dataset, owner, statsAll, последние адреса. Создаётся при первом старте.
# Пусто — users.json в корне проекта (НЕ в public/: та папка раздаётся статикой).
USERS_FILE=
# Вход можно выключить на время отладки: REQUIRE_LOGIN=0
REQUIRE_LOGIN=1

# === AI (Anthropic) ===
# Ключ создаётся в console.anthropic.com → API Keys. Никогда не коммитить реальное значение.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# Потолок API у Claude — 128000 выходных токенов, больше config.js не пропустит;
# ответы идут стримингом, большие значения безопасны. Thinking расходует тот же лимит.
ANTHROPIC_MAX_TOKENS=16384
ANTHROPIC_REQUEST_TIMEOUT=300000
ANTHROPIC_MAX_RETRIES=3
# Ключ администратора организации Anthropic (sk-ant-admin…) — ТОЛЬКО для
# вкладки «Статистика»: показывает расход по данным биллинга вместо нашей
# оценки по тарифам. Остаток кредитов Admin API не отдаёт вовсе, его считает
# платформа как «внесено минус потрачено». Для личного аккаунта без
# организации Admin API недоступен — оставьте пустым.
ANTHROPIC_ADMIN_KEY=

# === Локальная модель (OpenAI-совместимый сервер, например LM Studio) ===
# Провайдер: auto (по умолчанию) — Anthropic при наличии ключа, иначе локальный сервер, иначе демо.
# Явно: anthropic | local | mock
AI_PROVIDER=auto
LOCAL_AI_BASE_URL=http://localhost:1234/v1
# Чат/анализ (структурный JSON)
LOCAL_AI_MODEL=qwen/qwen3.8-27b
# Vision-модель для распознавания сканов. vl-8b выиграла слепой A/B у vl-30b
# (6:4, ср. 7.0 vs 6.4) на сканах СП/ГОСТ, в 2-4 раза быстрее и помещается в
# память РЯДОМ с чат-моделью (без свопов) — если нужна скорость, ставьте qwen/qwen3-vl-8b.
LOCAL_AI_OCR_MODEL=qwen/qwen3-vl-30b
LOCAL_AI_MAX_TOKENS=12288
# Очередь LM Studio может быть занята (OCR и др.) — таймаут одного обращения, мс
LOCAL_AI_TIMEOUT=480000
# Сколько символов документа уходит локальной модели за раз
LOCAL_AI_DOC_CHAR_LIMIT=45000
# Потолок одного запроса с файлами (Content-Length) и одной записи zip до распаковки
UPLOAD_TOTAL_MB=200
ZIP_ENTRY_MB=50
# Контекст при явной загрузке моделей (server/services/model-manager.js).
# Умолчание консервативное. Рабочее окно qwen3.8-27b на маке с 48 ГБ — 71936
# (лимит GPU 36 GiB с 01.09.2026; выше — риск паник ядра). Подбирайте под RAM:
# веса модели + KV-кэш ≤ лимита Metal, а prefill длинного промпта должен
# успевать в LOCAL_AI_TIMEOUT.
LOCAL_AI_CONTEXT=32768
LOCAL_AI_OCR_CONTEXT=65536
# Одна модель за раз: загрузилась → отработала → выгрузилась (0 — прежнее
# поведение: вытеснять соседей только при нехватке памяти)
LOCAL_AI_EXCLUSIVE=1
# «Изучение документации»: сколько страниц PDF-скана распознаёт vision-модель на файл
VISION_MAX_PAGES=50

# === Лимиты загрузки ===
MAX_FILE_SIZE_MB=25
MAX_TOTAL_UPLOAD_MB=60
MAX_FILES_PER_SESSION=10
# Потолок текста ОДНОГО документа в «Анализе ТЗ» и «Проверке документа», символов:
# больше — честный 422 с числами, а не многомегабайтный txt в SQLite
DOC_CHAR_LIMIT=1500000

# === Лимиты диалога и расходов ===
MAX_MESSAGE_LENGTH=4000
# Считаются только запросы человека: анализ, реплика в чате, прогон этапа.
# Служебные (распознавание страниц, конспекты документов) идут отдельным счётчиком
# и лимит не расходуют — иначе скан на 17 страниц выбирает его ещё до анализа.
MAX_AI_REQUESTS_PER_SESSION=25
MAX_TOKENS_PER_SESSION=2000000
MAX_CONCURRENT_JOBS=2
# Общая касса обращений к модели на ОДИН анализ и глубина склейки обрезанного
# ответа. Прежние 4 и 2 выбирались одним неудачным прогоном насквозь (вызов + два
# продолжения + повтор), и вместо отчёта человек получал «4 из 4». Касса конечна
# намеренно: безнадёжный прогон обязан кончаться, а не уходить в десятки запросов.
MAX_ANALYSIS_CALLS=12
MAX_CONTINUATIONS=4
# Потолок кругов уточнений: после стольких отвеченных вопросов анализ обязан
# выпустить отчёт на допущениях — без потолка модель спрашивает бесконечно
MAX_CLARIFICATION_ANSWERS=8
# Проверяющий перед отправкой (adversary): черновик ответа уходит той же модели
# на проверку противоречий фактам, выдуманных оснований и ухода от вопроса;
# «revise» — одна доработка. Служебное обращение: счётчик запросов не тратит.
# 0 — выключить целиком, ответы уходят как есть.
ADVERSARY_REVIEW=1

# === Память диалога ===
RECENT_MESSAGES_IN_CONTEXT=24
COMPACT_AFTER_MESSAGES=40

# === Сессии и очистка ===
# 0 — хранение бессрочное, очистка отключена
SESSION_TTL_HOURS=72
CLEANUP_INTERVAL_MINUTES=30

# === Rate limiting (на IP, окно в мс) ===
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_GENERAL=120
RATE_LIMIT_EXPENSIVE=12
# Попытки входа лимитируются отдельно и жёстче: вход без пароля — значит перебор
# имён должен упираться в лимит
RATE_LIMIT_AUTH=12
# Срок токена человека без активности, дней (0 — бессрочно); активность продлевает сама
USER_TOKEN_DAYS=30
# Во сколько раз общий лимит на адрес TCP-соединения больше лимита на посетителя.
# Адрес посетителя приходит заголовком от cloudflared, а заголовок подделывается;
# этот потолок считается по соединению и заголовками не обходится.
RATE_LIMIT_PEER_FACTOR=20

# === База знаний (RAG): путь к папке Knowledge-Base ===
KB_DIR=
KB_EMBEDDING_MODEL=text-embedding-qwen3-embedding-0.6b
KB_TOP_K=6
# База «Верифицировано»: разбор по пунктам и таблицам
# (по умолчанию — папка Knowledge-Base-Верифицировано рядом с основной;
# подключается, только если каталог существует). Документы, разобранные здесь,
# из общей базы больше не выдаются. База Гриши из выбора убрана.
KB_VERIFIED_DIR=

# === Облако через мак (маршрут /cloud на шлюзе) =========================
# Сервер платформы стоит в Москве, а России нет в списках поддерживаемых
# стран Anthropic, OpenAI и Google: обращение с этой машины нарушает их
# условия само по себе, кто бы его ни затеял. Мак стоит там, где владелец,
# поэтому наружу ходит он — через шлюз ~/enso/mac (ai-gateway.js, порт 1235,
# поднимает launchd; в этом репозитории его нет).
#
# Настоящие ключи живут в конфиге шлюза НА МАКЕ. Сюда вписывается любая
# непустая строка ЛАТИНИЦЕЙ (кириллица в заголовке роняет запрос: заголовки
# HTTP — ByteString): она нужна платформе только чтобы считать провайдера
# настроенным, наружу не уходит — шлюз заменит её своим ключом.
# Kimi с VPS тоже ходит через шлюз (маршрут /cloud/moonshot): DPI режет
# большие запросы за границу напрямую.
#
# Пусто — прежнее поведение: SDK идёт к провайдеру напрямую.
#   ANTHROPIC_API_KEY=via-mac-gateway
#   ANTHROPIC_BASE_URL=http://100.72.145.120:1235/cloud/anthropic
#   OPENAI_API_KEY=via-mac-gateway
#   OPENAI_BASE_URL=http://100.72.145.120:1235/cloud/openai/v1
#   GEMINI_API_KEY=via-mac-gateway
#   GEMINI_BASE_URL=http://100.72.145.120:1235/cloud/gemini
ANTHROPIC_BASE_URL=

# === OpenAI (ChatGPT) — выбор в интерфейсе ===
# Аккаунт OpenAI деактивирован 2026-08-10 (доступ из неподдерживаемого региона и
# раздача ключа другим людям); маршрут в коде живой, ключа нет.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
# Пусто в .env НЕ означает «без адреса»: config.js подставит api.openai.com
OPENAI_BASE_URL=https://api.openai.com/v1
# GPT-5.x — reasoning-модели: max_completion_tokens включает и токены размышлений.
# Потолок API семейства GPT-5.6 — 128000, больше config.js не пропустит.
OPENAI_MAX_TOKENS=16384
# minimal | low | medium | high; пустая строка — не отправлять параметр
OPENAI_REASONING_EFFORT=low

# === Ollama — скрытый маршрут (в пикере нет) ===
OLLAMA_BASE_URL=http://localhost:11434/v1

# === Kimi (Moonshot AI) — OpenAI-совместимый API, ключ с platform.moonshot.ai ===
KIMI_API_KEY=
KIMI_MODEL=kimi-k2.6
# С VPS — через шлюз мака, см. блок «Облако через мак»
KIMI_BASE_URL=https://api.moonshot.ai/v1
# Окно моделей Moonshot — 262144 токена, отдельного потолка на ответ у API нет.
# kimi-k3 — рассуждающая модель: размышления расходуют этот же лимит, урезать
# его нельзя — иначе весь бюджет уходит на мысли и ответ приходит пустым.
KIMI_MAX_TOKENS=262144

# === Gemini (Google) — выбор в интерфейсе per session ===
# Ключ создаётся в Google AI Studio → API keys. Только на сервере: во фронтенд,
# в базу и в логи он не попадает. Вставьте после «=» без пробелов.
GEMINI_API_KEY=
# Пусто — модель берётся первой из списка, доступного аккаунту (имена не зашиты в код)
GEMINI_MODEL=
# Своя точка входа нужна только для Vertex AI или корпоративного прокси
GEMINI_BASE_URL=
GEMINI_MAX_TOKENS=65536

# === GigaChat (Сбер) — облако, доступное из России ===
# Сервер платформы стоит в Москве и ходит к GigaChat напрямую, без шлюза
# на маке. Ключ авторизации выдаёт кабинет developers.sber.ru (проект
# GigaChat API → «Ключ авторизации», строка Basic целиком, без слова Basic).
# На каждый вызов он меняется на access_token сроком 30 минут — этим занимается
# server/services/ai/gigachat.js, в .env живёт только постоянный ключ.
#
# ВАЖНО: TLS-сертификат у API от НУЦ Минцифры, в комплекте Node его нет.
# Процессу платформы нужен российский корневой сертификат:
#   Environment=NODE_EXTRA_CA_CERTS=/opt/enso/certs/russian_trusted_root_ca.pem
# (строка в юните systemd; сам сертификат — с gosuslugi.ru/crt).
GIGACHAT_AUTH_KEY=
# GIGACHAT_API_PERS — физлицо; GIGACHAT_API_B2B / GIGACHAT_API_CORP — юрлицо
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2
GIGACHAT_BASE_URL=https://gigachat.devices.sberbank.ru/api/v1
GIGACHAT_OAUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
# Потолок ответа в справочнике Сбера не зафиксирован — консервативные 4096;
# обрезанный ответ дочитывается продолжениями
GIGACHAT_MAX_TOKENS=4096

# === YandexGPT (Яндекс) — облако, доступное из России ===
# Идёт через OpenAI-совместимый слой Yandex Cloud. В консоли Yandex Cloud:
# сервисный аккаунт с ролью ai.languageModels.user → API-ключ; каталог (folder)
# берётся из адресной строки консоли. Тарифицируется в рублях — расход считает
# кабинет Яндекса, в долларовый счётчик платформы он не попадает.
# 403 при верном ключе лечится привязкой платёжного аккаунта к каталогу.
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
# Короткое имя дополняется до gpt://<каталог>/<модель> в адаптере
YANDEX_MODEL=yandexgpt/latest
YANDEX_BASE_URL=https://llm.api.cloud.yandex.net/v1
YANDEX_MAX_TOKENS=8000

# === Доступ к облачным моделям ===
# Условия OpenAI, Anthropic и Google запрещают не только пользоваться сервисом
# из неподдерживаемого региона, но и ОТКРЫВАТЬ к нему доступ другим людям
# («accessing or offering access…»). Платформа отдаёт один ключ на всех вошедших,
# и за это аккаунт OpenAI деактивировали 2026-08-10.
#
# Поэтому облачные модели доступны только людям с "cloudAi": true в users.json.
# Остальные работают на локальных моделях. Проверка — в services/ai/cloud-access.js,
# на дне адаптера.
#
# CLOUD_AI_OPEN=1 возвращает прежнее поведение (облако всем). Нужно тестам
# и отладке; в боевой конфигурации ставить нельзя.
CLOUD_AI_OPEN=
#
# Облачные провайдеры, открытые ВСЕМ вошедшим, через запятую — тоньше, чем
# гейт cloudAi «всё или ничего». Список белый: забытая переменная означает
# «никому», а не «всем». На VPS перечислены все шесть (2026-08-24).
# Claude, ChatGPT и Gemini этим списком НЕ открываются (с 2026-09-02): им нужна
# отметка "cloudAi": true у человека в users.json. Список действует на Kimi, GigaChat, YandexGPT.
#   CLOUD_AI_OPEN_PROVIDERS=kimi,gigachat,yandexgpt
CLOUD_AI_OPEN_PROVIDERS=
#
# Имена платформы, на которых привязанное облако вообще предлагается.
# У платформы два адреса, и за ними разные аудитории: на .com работает всё,
# .ru остаётся на моделях, доступных из России, — локальных, Kimi, GigaChat
# и YandexGPT. Имя приходит с каждым запросом само (nginx передаёт Host),
# поэтому список людей вести не нужно.
#
# Список белый: пусто — ограничения нет, облако доступно на любом адресе.
# Заполнен — на всех остальных именах привязанные модели закрыты ВСЕМ, включая
# владельца, а проект, который ещё ни разу не открывали, их не получает.
#
#   CLOUD_AI_HOSTS=enso-nexus.com,www.enso-nexus.com
CLOUD_AI_HOSTS=
#
# Кого именно привязка касается. Пусто — всех облачных (прежнее поведение:
# забытая переменная не имеет права молча открыть западное облако на .ru).
# Перечислены — только они живут на именах из CLOUD_AI_HOSTS, остальные
# облачные (Kimi, GigaChat, YandexGPT) работают на любом адресе.
#
#   CLOUD_AI_HOSTS_PROVIDERS=claude,chatgpt,gemini
CLOUD_AI_HOSTS_PROVIDERS=

# === Модуль «Датасет»: пары для LoRA-дообучения локальных моделей ===
# 1 — открыт всем вошедшим (решение владельца 2026-08-24); 0 — только владельцу
# и людям с "dataset": true в users.json
DATASET_OPEN=1
# Модель генерации черновиков пар (меняется в настройках модуля; это умолчание).
# qwen3-coder-30b держит строгий JSON — черновик всё равно читает человек.
DATASET_GEN_PROVIDER=lmstudio
DATASET_GEN_MODEL=qwen/qwen3-coder-30b

# ── Мост к AutoCAD for Mac (выгрузка DWG) ───────────────────────────────
# DWG создаёт сам AutoCAD: сервер передаёт мосту claude-acad-bridge.lsp команды
# построения и просит выгрузить результат через -WBLOCK. Открытый чертёж
# пользователя при этом не меняется.
# Требуется: AutoCAD запущен, мост загружен (APPLOAD → claude-acad-bridge.lsp),
# у Node есть доступ в «Системные настройки → Универсальный доступ».
ACAD_ENABLED=1
ACAD_APP_NAME=AutoCAD 2027
# auto — сервер сам вводит CLAUDE-PUMP; manual — команду вводит человек
# (или заранее запущен CLAUDE-SERVE в AutoCAD)
ACAD_TRIGGER=auto
ACAD_TIMEOUT_MS=90000
# Папка обмена; пусто — ~/Library/Application Support/ClaudeAcadMCP/exchange
ACAD_EXCHANGE_DIR=
# Запасной путь при закрытом AutoCAD: конвертер LibreDWG (кириллицу в именах
# слоёв держит не всегда, файл помечается как «(конвертер)»)
ACAD_CONVERTER_FALLBACK=1

# --- Модуль «Нормоконтроль» ---
# Своя БД PostgreSQL + pgvector (brew postgresql@17 на порту 5433: системный
# PostgreSQL 18 на 5432 живёт без pgvector). База создаётся руками: createdb enso_normo,
# схему модуль разворачивает сам при первом запросе.
NORMO_DATABASE_URL=postgresql://127.0.0.1:5433/enso_normo
# Файлы версий разделов и заключений; пусто — data/normo
NORMO_DATA_DIR=
# База знаний модуля (rules/, knowledge/, templates/); пусто — каталог
# «нормоконтроль» в корне проекта
NORMO_KB_DIR=
# Читается в config.js (normoLlmEnabled): 0 выключает смысловые LLM-проверки,
# детерминированный слой работает всегда
NORMO_LLM=1

# --- НЕ переменные сервера: python-скрипт нормоконтроль/tools/telegram ---
# Их читает fetch_ai_prompt_eng.py (Этап 0-Б, выгрузка канала через MTProto),
# config.js о них не знает. Получить на my.telegram.org → API development tools;
# вход в аккаунт делается отдельно:
#   нормоконтроль/tools/telegram/.venv/bin/python нормоконтроль/tools/telegram/fetch_ai_prompt_eng.py --login
TG_API_ID=
TG_API_HASH=
